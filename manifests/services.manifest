# Aegir's boot manifest. See specs/services.md for the format, the fields and
# the rules director validates against.
#
# This file is packed into director's initrd under the flat name `services` and
# parsed at boot. It is data: changing the service set is an image change, not a
# code change. The authoritative copy will be served by a config service later.
#
# `owns` and `needs` are the port graph: a port has exactly one owner (its only
# reader), and whoever needs it may call it. Creation follows that graph, so an
# owner is always running before its first consumer, and a cycle stops the boot.

format = 1

# The logger owns the port everything else talks to, and is therefore first:
# a service that cannot say what it is doing is a service nobody can supervise.
[logger]
binary    = aegir-logger
authority = system
account   = system
owns      = log.main
restart   = always

# The device manager owns what the machine is, rather than director repeating it:
# it is given the device tree, reads it, and will hold the bus -> device -> service
# map that lets a driver be started for a device (specs/services.md).
[devicemgr]
binary    = aegir-device-manager
authority = system
account   = system
# The map it builds is a port it owns, so a service director starts can hold
# a caller half: count and describe ask what the machine is, and open
# introduces the caller to the driver bound to a row (specs/services.md).
owns      = devmgr.registry
needs     = log.main
restart   = always
# The machine's devices are given to this service and to no other: a device is a
# capability, so it cannot be handed out to everyone who might want one. No device
# is its own any more: the random number generator (virtio device 4) was, as the
# first proof that a service could read hardware, and the proof served -- the
# transport is bound from the driver registry like any other (specs/services.md).
device_manager = true
# The drivers are this service's to start, not director's: a device manager owns
# the bus -> device -> service map, so the process made for a device is made by
# the service that knows the bus (specs/services.md). Director delegates the
# authority -- an untyped, an ASID pool, its own VSpace root, the initrd, and the
# device frames as capabilities -- and skips starting what this names. The
# partition manager goes with it: the storage stack's composition belongs to the
# service that owns the devices, not to director's port graph.
spawns    = blkdriver, rngdriver, kbddriver, gpudriver, partmgr
# What that spawning costs: two 32 MiB scanout windows for the gpu drivers'
# framebuffers (megapages -- specs/services.md), the partition manager's
# megabyte, the filesystem image, and the drivers' images, queues and windows.
# The default 4 MiB delegation is auth's, not this service's.
delegate_mib = 68

# The block driver. Director's survey found virtio device 2 behind a transport, and this
# service asks for it by id -- one device per service, because a device is a capability and
# two services wanting two devices is what the bus map is for. It owns no port yet: serving
# a request needs a virtqueue, and the queue comes before the port (specs/services.md).
[blkdriver]
binary    = aegir-virtio-blk
authority = system
account   = system
needs     = log.main
device_id = 2
# Memory to lay a virtqueue out in. A driver needs some: the queue's descriptor entries
# carry *physical* addresses the device reads, and a service cannot find out where its own
# memory is -- so director carves a region, says where it is, and hands over the
# capability (specs/services.md, specs/authority.md).
memory_kib = 8
restart   = always

# The entropy driver. virtio device 4, bound from the registry row like any
# other driver (specs/services.md). It serves one method, `read`, answered in
# the port's own envelope -- entropy is small, so the registry row declares no
# shared window, and its first consumer finds the port through the registry's
# `open` rather than a static edge here.
[rngdriver]
binary    = aegir-virtio-rng
authority = system
account   = system
needs     = log.main
device_id = 4
# The queue's memory, as the block driver's above: the registry row is what
# the device manager carves by.
memory_kib = 16
restart   = always

# The keyboard driver. virtio device 18, bound from the registry row like any
# other (specs/services.md): two queues -- the event queue primed with one
# device-writable buffer per descriptor, the status queue idle -- and events
# answered in the port's own envelope (aegir/input.h), so no shared window.
# Its `next` is the first port that can say "wait": the reply is held until
# the interrupt lands.
[kbddriver]
binary    = aegir-virtio-input
authority = system
account   = system
needs     = log.main
device_id = 18
# Two queues take 16 KiB; the posted buffers take a page past them.
memory_kib = 32
restart   = always

# The display driver. virtio device 16, bound from the registry row like any
# other -- and bound *twice*: QEMU's command line carries two transports, the
# probe re-points both at the one row, and the spawn loop starts one process
# per head (specs/services.md). The framebuffer is the shared window the
# registry row declares (32 MiB of mega pages), not this memory: one control
# queue is all the queue the driver runs.
[gpudriver]
binary    = aegir-virtio-gpu
authority = system
account   = system
needs     = log.main
device_id = 16
# One queue is 8 KiB; the command and response buffers live in its page.
memory_kib = 8
restart   = always

# The partition manager. The device manager starts it once block drivers answer,
# and hands it their ports: reading partition tables is a filesystem-agnostic job
# that belongs above the drivers, not inside them (specs/services.md). Its spawn
# right is a class: filesystem services are `fs.*`, so a new filesystem type in
# the class is a new entry here, not an authority change.
[partmgr]
binary    = aegir-partmgr
authority = system
account   = system
needs     = log.main, vfs.namespace
spawns    = fs.*
restart   = always

# The FAT filesystem service: one instance per FAT partition, started by the
# partition manager with the block device's port and a range grant rather than
# the whole device (specs/services.md). FAT16/32/ExFAT are the interchange
# filesystems -- not Aegir's own -- and read-only to begin with.
[fs.fat]
binary    = aegir-fs-fat
authority = system
account   = system
needs     = log.main
restart   = always

# The VFS owns the namespace -- volume names, path resolution -- and not the
# data (specs/vfs.md). It must exist before any filesystem, so filesystems
# have somewhere to register. Its port carries capabilities, which the port
# graph notes for the rights both halves need.
[vfs]
binary    = aegir-vfs
authority = system
account   = system
owns      = vfs.namespace
needs     = log.main
# The registration table's backing store: the map grows until this is gone,
# and reaching the end of it is a loud refusal, never a quiet overwrite.
memory_kib = 16
restart   = always

# The initrd service serves the boot image itself as the Initrd: volume --
# the flat archive, mapped read-only (`initrd = true`, the same mapping a
# spawner gets without the spawn authority), registered with the VFS by the
# service itself, read out of in place (specs/vfs.md). It must start after
# the VFS, so its volume exists before anything that reads the boot image.
# Its name is not in the fs.* class on purpose: that class is partmgr's
# spawn right, and this service is director's to start.
[initrd]
binary    = aegir-fs-initrd
authority = system
account   = system
owns      = vol.initrd
needs     = log.main, vfs.namespace
initrd    = true
restart   = always

# The console owns the display and the input devices, exclusively
# (specs/console.md): what every other process sees of the screen and the
# keyboard is what it serves. It maps the gpu's pixel window itself --
# `maps` is the spawner's vspace grant without the spawn authority -- so
# its memory is what page tables and the clients' pixel slices are retyped
# from: the test bed's 2 MiB, the greeter's 2, and the bureau's 4 -- a
# full-screen 32-bit backdrop is 4 MiB at the preferred mode. A carve's
# watermark is the console's to spend, not to take back, until the
# re-login arc -- so the greeter's slice stays spent after the reap, and
# the budget carries the boot's three slices at once.
[console]
binary    = aegir-console
authority = system
account   = system
owns      = console.gui
needs     = log.main, devmgr.registry
maps      = true
memory_kib = 16384
restart   = always

# auth owns the user database and the login port (specs/auth.md): it reads
# the packed table from Initrd: through the namespace -- the first system
# consumer of the VFS -- and serves auth.login from it. It is also a
# spawner: a successful login starts a session, so its memory is the
# untyped it is delegated, and its table and its sessions both come out
# of it. console.gui is its own caller half: a login through the greeter
# ends with auth reaping the greeter's windows and slice (specs/console.md).
[auth]
binary    = aegir-auth
authority = system
account   = system
owns      = auth.login
needs     = log.main, vfs.namespace, console.gui
spawns    = session.*, greeter
restart   = always

# The login window (specs/console.md's login arc): auth's face, started once
# the user database is read, badged from auth's own range (specs/authority.md).
# Nothing else starts it, and its needs are what drives the delegatable
# copies auth's spawn kit carries for it.
[greeter]
binary    = aegir-greeter
authority = system
account   = system
needs     = console.gui, auth.login
restart   = never

# The spawn smoke client. It proves the C++ path end to end (ABI, static
# constructors, TLS, floating point, console) and now also that a spawned process
# can call a port it was given.
[hello]
binary    = aegir-hello
authority = system
account   = boot
needs     = log.main
restart   = never

[test]
binary    = aegir-test
authority = system
account   = boot
needs     = log.main, vfs.namespace, auth.login, devmgr.registry, console.gui
# The window protocol's first client: it maps its arena slice itself, so it
# gets the maps grant like the console, and the memory is what its page
# tables for that mapping are retyped from.
maps      = true
memory_kib = 2048
restart   = never

# The first session (specs/auth.md). Nothing starts it at boot -- auth
# starts one when a login succeeds, with the user's badge and account.
# Input it has none of: the devices are the console's (specs/console.md),
# and a session's events arrive as windows' events when the bureau lands.
# The entry is what declares a session's needs, which is what drives the
# delegatable copies its spawner is given.
[session.smoke]
binary    = aegir-session-smoke
authority = user
account   = user
needs     = log.main, vfs.namespace
restart   = never

# The bureau (specs/console.md's login arc): the session a login through the
# greeter starts -- the Amiga screen as a shape of window, always backdrop
# mode, Workbench grey. It draws and exits; the console owns the slice, so
# the window persists, and the screen is the session's visible remainder.
# console.gui is what sets it apart from the smoke: a bureau maps its slice
# and paints it, which is also why the spawn carries the vspace and untyped
# grants the smoke never needs.
[session.bureau]
binary    = aegir-bureau
authority = user
account   = user
needs     = log.main, vfs.namespace, console.gui
restart   = never
