# Aegir's boot manifest. See specs/services.md for the format, the fields and
# the rules director validates against.
#
# This file is packed into director's initrd under the flat name `services` and
# parsed at boot. It is data: changing the service set is an image change, not a
# code change. The authoritative copy will be served by a config service later.
#
# `owns` and `needs` are the port graph: a port has exactly one owner (its only
# reader), and whoever needs it may call it. Creation follows that graph, so an
# owner is always running before its first consumer, and a cycle stops the boot.

format = 1

# The logger owns the port everything else talks to, and is therefore first:
# a service that cannot say what it is doing is a service nobody can supervise.
[logger]
binary    = aegir-logger
authority = system
account   = system
owns      = log.main
restart   = always

# The device manager owns what the machine is, rather than director repeating it:
# it is given the device tree, reads it, and will hold the bus -> device -> service
# map that lets a driver be started for a device (specs/services.md).
[devicemgr]
binary    = aegir-device-manager
authority = system
account   = system
needs     = log.main
restart   = always
# The machine's devices are given to this service and to no other: a device is a
# capability, so it cannot be handed out to everyone who might want one.
# `device_id` is what a service is *for*: the bus's id for the device it drives, which
# director looks up in the survey of what the machine has. The random number generator
# is virtio device 4 (`VIRTIO_ID_*`, projects/sel4_projects_libs/libsel4vmmplatsupport);
# the block device is 2, which is what a driver will claim.
device_manager = true
device_id  = 4

# The block driver. Director's survey found virtio device 2 behind a transport, and this
# service asks for it by id -- one device per service, because a device is a capability and
# two services wanting two devices is what the bus map is for. It owns no port yet: serving
# a request needs a virtqueue, and the queue comes before the port (specs/services.md).
[blkdriver]
binary    = aegir-virtio-blk
authority = system
account   = system
needs     = log.main
device_id = 2
# Memory to lay a virtqueue out in. A driver needs some: the queue's descriptor entries
# carry *physical* addresses the device reads, and a service cannot find out where its own
# memory is -- so director carves a region, says where it is, and hands over the
# capability (specs/services.md, specs/authority.md).
memory_kib = 4
restart   = always

# The spawn smoke client. It proves the C++ path end to end (ABI, static
# constructors, TLS, floating point, console) and now also that a spawned process
# can call a port it was given.
[hello]
binary    = aegir-hello
authority = system
account   = boot
needs     = log.main
restart   = never
